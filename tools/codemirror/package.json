{
  "name": "numwis-codemirror-bundle",
  "private": true,
  "description": "Builds assets/vendor/codemirror.js (CodeMirror 6 + Python mode) as one ES module",
  "scripts": {
    "build": "esbuild entry.js --bundle --format=esm --minify --legal-comments=eof --outfile=../../assets/vendor/codemirror.js"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "esbuild": "0.28.2"
  }
}
